# Copy this file to ".env" and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
# These two values are designed to be public; security comes from the
# database Row Level Security rules in supabase/schema.sql.
# NEVER put the "service_role" key in this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
